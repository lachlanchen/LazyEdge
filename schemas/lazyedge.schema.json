{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazying.art/schemas/lazyedge/v1alpha1.json",
  "title": "LazyEdge EdgeProject",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "lazyedge.lazying.art/v1alpha1" },
    "kind": { "const": "EdgeProject" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge", "transport", "services"],
      "properties": {
        "edge": { "$ref": "#/$defs/edge" },
        "transport": { "$ref": "#/$defs/transport" },
        "services": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/service" }
        }
      }
    }
  },
  "$defs": {
    "listen": {
      "type": "string",
      "pattern": "^127\\.0\\.0\\.1:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "privateListen": {
      "type": "string",
      "pattern": "^127\\.0\\.0\\.1:(?:10(?:2[4-9]|[3-9][0-9])|1[1-9][0-9]{2}|[2-9][0-9]{3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "loopbackHttpUrl": {
      "type": "string",
      "pattern": "^http://127\\.0\\.0\\.1:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "existingSiteUrl": {
      "type": "string",
      "pattern": "^https?://127\\.0\\.0\\.1:(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "hostname": {
      "type": "string",
      "minLength": 4,
      "maxLength": 253,
      "pattern": "^(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z][a-z0-9-]{1,62}$"
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gatewayListen"],
      "properties": {
        "gatewayListen": { "$ref": "#/$defs/listen" },
        "compatibilityListen": { "$ref": "#/$defs/listen" },
        "compatibilityService": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "privateListeners": {
          "description": "Loopback-only listeners whose service references must resolve to services with exposure private; the manifest normalizer enforces this cross-array invariant for CLI and direct APIs.",
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["service", "listen"],
            "properties": {
              "service": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,62}$"
              },
              "listen": { "$ref": "#/$defs/privateListen" }
            }
          }
        },
        "httpPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "httpsPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "existingSites": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host", "upstream"],
            "properties": {
              "host": { "$ref": "#/$defs/hostname" },
              "upstream": { "$ref": "#/$defs/existingSiteUrl" },
              "tlsServerName": { "$ref": "#/$defs/hostname" }
            }
          }
        }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "sshHost", "sshUser"],
      "properties": {
        "provider": { "const": "openssh-reverse" },
        "sshHost": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*$"
        },
        "sshUser": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,30}$"
        },
        "sshPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "hostKeyAlias": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "methods"],
      "properties": {
        "maxBodyBytes": {
          "description": "Optional request-body limit for only this exact path and its declared methods; otherwise inherit public.maxBodyBytes.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "path": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^/(?:[A-Za-z0-9._~-]+/)*[A-Za-z0-9._~-]+$"
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["DELETE", "GET", "HEAD", "OPTIONS", "PATCH", "POST", "PUT"]
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "domains", "edge", "worker", "public"],
      "allOf": [
        {
          "if": {
            "required": ["exposure"],
            "properties": { "exposure": { "const": "private" } }
          },
          "then": {
            "properties": { "domains": { "maxItems": 0 } }
          },
          "else": {
            "properties": { "domains": { "minItems": 1 } }
          }
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "exposure": {
          "description": "Public services use DNS ingress. Private services require exactly one matching spec.edge.privateListeners entry and cannot be selected by a public or compatibility listener.",
          "enum": ["public", "private"],
          "default": "public"
        },
        "domains": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hostname" }
        },
        "profile": {
          "enum": ["generic-http", "localllm-openai", "localllm-openai-admission"]
        },
        "edge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["upstream"],
          "properties": {
            "upstream": { "$ref": "#/$defs/loopbackHttpUrl" }
          }
        },
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["listen", "target"],
          "properties": {
            "listen": { "$ref": "#/$defs/listen" },
            "target": { "$ref": "#/$defs/loopbackHttpUrl" },
            "healthPath": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^/(?!v1/)(?:[A-Za-z0-9._~-]+/)*[A-Za-z0-9._~-]+$"
            }
          }
        },
        "public": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokenSet", "routes"],
          "properties": {
            "tokenSet": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$"
            },
            "routes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": { "$ref": "#/$defs/route" }
            },
            "maxBodyBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1073741824
            },
            "maxConcurrentRequests": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "idleTimeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "forwardCookies": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
