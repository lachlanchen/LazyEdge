{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazying.art/schemas/lazyedge/edge-rollout-v1alpha1.json",
  "title": "LazyEdge EdgeRollout",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "lazyedge.lazying.art/v1alpha1" },
    "kind": { "const": "EdgeRollout" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeProjectDigest", "deploymentId", "artifacts"],
      "properties": {
        "edgeProjectDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "deploymentId": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]{15,127}$"
        },
        "artifacts": {
          "description": "The CLI normalizer additionally rejects duplicate artifact IDs and paths and group/world-writable modes.",
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "owner", "group", "mode", "type"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "path": {
          "description": "Canonical absolute ASCII path. The CLI normalizer rejects dot components, repeated separators, trailing separators, backslashes, and components longer than 255 bytes.",
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "pattern": "^/(?:[A-Za-z0-9._@+-]+/)*[A-Za-z0-9._@+-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "owner": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
        },
        "group": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
        },
        "mode": {
          "description": "Exact four-digit Unix mode; the CLI normalizer rejects group/world write bits.",
          "type": "string",
          "pattern": "^0[0-7]{3}$"
        },
        "type": { "const": "regular-file" }
      }
    }
  }
}
