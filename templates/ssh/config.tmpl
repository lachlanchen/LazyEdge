# Reference only. Use renderOpenSshConfig() for one pinned connection.
Host lazyedge-edge
    HostName {{EXACT_EDGE_HOST}}
    User {{TUNNEL_USER}}
    IdentityFile {{PRIVATE_KEY_PATH}}
    UserKnownHostsFile {{PINNED_KNOWN_HOSTS_PATH}}
    StrictHostKeyChecking yes
    UpdateHostKeys no
    BatchMode yes
    ExitOnForwardFailure yes
    ServerAliveInterval 15
    ServerAliveCountMax 3
    ClearAllForwardings no
    ForwardAgent no
    ForwardX11 no
    RequestTTY no
    SessionType none
    RemoteForward 127.0.0.1:{{REMOTE_PORT}} 127.0.0.1:{{WORKER_GUARD_PORT}}
